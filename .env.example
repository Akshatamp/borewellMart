SECRET_KEY=django-insecure-change-this-in-production-use-python-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (for sending registration emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=BorewellMart <noreply@borewellmart.com>
FRONTEND_URL=http://localhost:8000
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_CURRENCY=INR
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# CSRF and Security Settings for Production
# Add your production domain(s) here (https:// and http://)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com,http://yourdomain.com
# Set to True in production if using HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
